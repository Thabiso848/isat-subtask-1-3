<mxfile host="app.diagrams.net" modified="2026-11-19T07:10:00.000Z" agent="ChatGPT" version="24.7.17" type="device">
  <diagram id="phone-detector" name="Mobile Phone Detector">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Mobile Phone RF Detector — Draw.io concept schematic&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;9 V supply • LM358 • BC337 • antenna • LED indicator&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="260" y="20" width="620" height="55" as="geometry"/></mxCell>
        <mxCell id="bat" value="&lt;b&gt;BT1&lt;/b&gt;&lt;br&gt;9 V battery&lt;br&gt;+9 V / 0 V" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="105" height="70" as="geometry"/></mxCell>
        <mxCell id="ant" value="&lt;b&gt;ANT1&lt;/b&gt;&lt;br&gt;Antenna wire&lt;br&gt;approx. 10–15 cm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="130" height="65" as="geometry"/></mxCell>
        <mxCell id="c1" value="&lt;b&gt;C1&lt;/b&gt;&lt;br&gt;1 µF&lt;br&gt;RF pickup coupling" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="220" y="100" width="120" height="60" as="geometry"/></mxCell>
        <mxCell id="u1" value="&lt;b&gt;U1 — LM358&lt;/b&gt;&lt;br&gt;Pin 8 = +9 V&lt;br&gt;Pin 4 = 0 V&lt;br&gt;Pin 1 = OUT A&lt;br&gt;Pin 2 = IN A−&lt;br&gt;Pin 3 = IN A+&lt;br&gt;Pin 5 = IN B+&lt;br&gt;Pin 6 = IN B−&lt;br&gt;Pin 7 = OUT B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="430" y="150" width="190" height="210" as="geometry"/></mxCell>
        <mxCell id="r1" value="&lt;b&gt;R1&lt;/b&gt;&lt;br&gt;100 kΩ&lt;br&gt;input / bias network" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="220" y="220" width="125" height="60" as="geometry"/></mxCell>
        <mxCell id="r2" value="&lt;b&gt;R2&lt;/b&gt;&lt;br&gt;220 kΩ&lt;br&gt;reference / feedback network" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="220" y="310" width="145" height="60" as="geometry"/></mxCell>
        <mxCell id="r4" value="&lt;b&gt;R4&lt;/b&gt;&lt;br&gt;2 MΩ&lt;br&gt;sensitivity / feedback" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="430" y="420" width="145" height="60" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;b&gt;C2&lt;/b&gt;&lt;br&gt;1 µF&lt;br&gt;signal smoothing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="650" y="120" width="120" height="60" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;C3&lt;/b&gt;&lt;br&gt;100 µF / 16 V&lt;br&gt;supply smoothing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="650" y="220" width="145" height="65" as="geometry"/></mxCell>
        <mxCell id="q1" value="&lt;b&gt;Q1 — BC337&lt;/b&gt;&lt;br&gt;NPN transistor&lt;br&gt;Emitter → 0 V&lt;br&gt;Collector → LED−&lt;br&gt;Base ← LM358 output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="850" y="180" width="165" height="100" as="geometry"/></mxCell>
        <mxCell id="r3" value="&lt;b&gt;R3&lt;/b&gt;&lt;br&gt;1 kΩ&lt;br&gt;LED current limit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="850" y="340" width="145" height="60" as="geometry"/></mxCell>
        <mxCell id="led" value="&lt;b&gt;LED1&lt;/b&gt;&lt;br&gt;flashes on detected RF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1040" y="340" width="120" height="60" as="geometry"/></mxCell>
        <mxCell id="note" value="&lt;b&gt;Important design note&lt;/b&gt;&lt;br&gt;This is a Draw.io planning schematic, not yet a verified build-ready netlist. The exact LM358 input/feedback wiring must be checked against the chosen detector topology before powering the Fritzing build. A phone detector responds to RF transmissions (calls, texts, data/network bursts), not strictly to the ringtone audio; detection varies by phone/network." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="220" y="540" width="850" height="120" as="geometry"/></mxCell>
        <mxCell id="e1" value="RF pickup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeWidth=2;" edge="1" parent="1" source="ant" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="coupled RF signal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeWidth=2;" edge="1" parent="1" source="c1" target="u1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="bias" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeWidth=2;" edge="1" parent="1" source="r1" target="u1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="reference" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeWidth=2;" edge="1" parent="1" source="r2" target="u1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="detected / amplified signal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeWidth=2;" edge="1" parent="1" source="u1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="drive / hold" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeWidth=2;" edge="1" parent="1" source="c2" target="q1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="feedback / sensitivity" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeWidth=2;" edge="1" parent="1" source="u1" target="r4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="switch LED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeWidth=2;" edge="1" parent="1" source="q1" target="led"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="series current limit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeWidth=2;" edge="1" parent="1" source="r3" target="led"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="+9 V and 0 V supply" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeWidth=2;" edge="1" parent="1" source="bat" target="u1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="supply smoothing" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeWidth=2;" edge="1" parent="1" source="bat" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell>
